+// Honor requested F32 accumulation while retaining the original F16 operands.
+// This private reference repair does not change default-precision dot products.
+static void ggml_vec_dot_f16_acc_f32(int n, float * s, size_t bs,
+        const void * vx, size_t bx, const void * vy, size_t by, int nrc) {
+    GGML_ASSERT(nrc == 1);
+    const ggml_fp16_t * x = (const ggml_fp16_t *) vx;
+    const ggml_fp16_t * y = (const ggml_fp16_t *) vy;
+    float sum = 0.0f;
+    for (int i = 0; i < n; ++i) {
+        sum = fmaf(GGML_FP16_TO_FP32(x[i]), GGML_FP16_TO_FP32(y[i]), sum);
+    }
+    *s = sum;
+    GGML_UNUSED(bs); GGML_UNUSED(bx); GGML_UNUSED(by);
+}
+
+// A requested-F32 graph keeps an existing F32 right operand in F32.
+static void ggml_vec_dot_f16_f32_acc_f32(int n, float * s, size_t bs,
+        const void * vx, size_t bx, const void * vy, size_t by, int nrc) {
+    GGML_ASSERT(nrc == 1);
+    const ggml_fp16_t * x = (const ggml_fp16_t *) vx;
+    const float * y = (const float *) vy;
+    float sum = 0.0f;
+    for (int i = 0; i < n; ++i) {
+        sum = fmaf(GGML_FP16_TO_FP32(x[i]), y[i], sum);
+    }
+    *s = sum;
+    GGML_UNUSED(bs); GGML_UNUSED(bx); GGML_UNUSED(by);
+}
