 ggml_tensor * clip_graph::build_mm(ggml_tensor * w, ggml_tensor * x) const {
+    // This explicit CPU reference profile preserves original F32 activations.
+    // F16 and Q8_0 stored weights widen exactly; activations stay F32.
+    if (cpu_f32_dense && (w->type == GGML_TYPE_F16 || w->type == GGML_TYPE_Q8_0) && x->type == GGML_TYPE_F32) {
+        GGML_ASSERT(ggml_nelements(w) <= 128*1024*1024/4); // per-projection wide-weight bound
+        w = ggml_cast(ctx0, w, GGML_TYPE_F32);
+    }
     return ggml_mul_mat(ctx0, w, x);
 }
 
