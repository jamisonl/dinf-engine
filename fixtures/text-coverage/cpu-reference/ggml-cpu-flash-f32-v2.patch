+// Keep the existing half-rounded Q/K inputs, but honor requested F32 dot accumulation.
+static float ggml_flash_attn_ext_dot_f16_f32(
+        int64_t n, const ggml_fp16_t * x, const ggml_fp16_t * y) {
+    float sum = 0.0f;
+    for (int64_t i = 0; i < n; ++i) {
+        sum += GGML_CPU_FP16_TO_FP32(x[i]) * GGML_CPU_FP16_TO_FP32(y[i]);
+    }
+    return sum;
+}
